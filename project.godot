; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="中国:毛的遗产[godot二版]"
config/version="0.7.1"
run/main_scene="uid://bydan4iqthbaa"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/image="uid://vcsjiyi2j6yf"
config/icon="res://icon.svg"

[autoload]

GameRuntime="*res://src/compat/UnityRuntime.cs"
UiBridge="*res://src/bridge/UiBridge.cs"
"场景管理器"="*res://src/autoload/场景管理器.gd"
AudioSys="*res://src/autoload/音频总管.gd"
"按钮特效"="*res://src/autoload/按钮特效.gd"
UISettings="*res://src/autoload/UISettings.gd"
"触屏提示"="*res://src/autoload/触屏提示.gd"
"全局管理"="*res://src/autoload/全局管理.tscn"
"调试控制台"="*res://scenes/调试/调试控制台.tscn"
"在线更新"="*res://src/autoload/在线更新.gd"
"成就弹窗"="*res://scenes/成就/成就弹窗.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dotnet]

project/assembly_name="中国-毛的遗产[godot二版]"

[editor_plugins]

enabled=PackedStringArray("res://addons/copy_all_errors/plugin.cfg", "res://addons/godot_mcp_editor/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme/全局UI主题.tres"

