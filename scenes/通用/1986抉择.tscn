bbcode_enabled = true
text = "[center]同志！[/center]
　　我们已经迈上实现中华民族伟大复兴的光明大道！未来纵有艰难险阻，但只要不忘初心，砥砺前行，必然能赢得更加伟大的胜利和荣光。你就像我们的太阳，指引着人民前进的方向。

　　在这里可以选择继续掌权，直至永远，按照你的意愿塑造世界秩序，且在任何时候都可以结束游戏。但从新的时间段开始，将无法取得任何成就。

　　当然，也可以就此功成身退：只要选取右侧的按钮，即可结束游戏进入摘要窗口。此界面将对你这几年的执政作出评判，同时也会展示全球未来的走向。最最重要的是，可以解锁成就！

[center]现在由你抉择。[/center]"
fit_content = true
scroll_active = false

